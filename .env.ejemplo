# Plantilla de credenciales. Cópiese a `.env` y rellénese.
# `.env` está en .gitignore; esta plantilla sí se versiona.
#
#     cp .env.ejemplo .env && $EDITOR .env
#
# Las seis fuentes son opcionales e independientes: la compuerta de
# enriquecimiento usa las que encuentre y declara las que falten como
# NO CONSULTADAS, que no es lo mismo que «sin hallazgos».

CTI_THREATFOX_KEY=
CTI_VIRUSTOTAL_KEY=
CTI_SHODAN_KEY=
CTI_GREYNOISE_KEY=
CTI_ABUSEIPDB_KEY=
CTI_OTX_KEY=
